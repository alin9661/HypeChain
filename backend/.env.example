# Server Configuration
PORT=3001
NODE_ENV=development
HACKNYU_FRONTEND_URL=http://localhost:3000

# Database — Amazon Aurora DSQL (production)
# The Express backend connects via node-postgres with a short-lived IAM auth
# token (no static password) over TLS. The Lambda execution role needs the
# dsql:DbConnectAdmin permission on the cluster.
HACKNYU_DSQL_ENDPOINT=your-cluster-id.dsql.us-east-1.on.aws
HACKNYU_DSQL_REGION=us-east-1
HACKNYU_DSQL_DATABASE=postgres

# Local/CI escape hatch — plain Postgres DSN, dev-only (fail-closed).
# Honored ONLY when NODE_ENV=development; refuses to activate otherwise so a
# stray value can never downgrade production to a plaintext, non-IAM connection.
# Apply backend/schema/001_dsql_schema.sql to this database first.
# HACKNYU_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hypechain
HACKNYU_POSTGRES_URL_NON_POOLING=postgres://postgres:[password]@db.[project-id].supabase.co:5432/postgres
HACKNYU_POSTGRES_PRISMA_URL=postgres://postgres:[password]@db.[project-id].supabase.co:5432/postgres?pgbouncer=true&connect_timeout=15
HACKNYU_POSTGRES_USER=postgres
HACKNYU_POSTGRES_HOST=db.[project-id].supabase.co
HACKNYU_POSTGRES_PASSWORD=your_database_password_here
HACKNYU_POSTGRES_DATABASE=postgres

# OpenRouter API Configuration (for AI-powered features)
# Get from: https://openrouter.ai/keys
HACKNYU_OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Model Selection (optional - defaults shown below)
# Vision models: openai/gpt-4o, zhipuai/glm-4-plus, openai/gpt-4-vision-preview, anthropic/claude-3.5-sonnet, google/gemini-pro-vision
HACKNYU_DEFAULT_VISION_MODEL=openai/gpt-4o
# Image generation models: openai/gpt-5-image-mini, zhipuai/glm-4-plus, openai/dall-e-3, stability-ai/stable-diffusion-xl
HACKNYU_DEFAULT_IMAGE_GEN_MODEL=openai/gpt-5-image-mini

# Redis Cache Configuration (optional - for cost optimization)
# Set to 'false' to disable caching
HACKNYU_REDIS_ENABLED=true
# Redis connection URL (local: redis://localhost:6379, or use Redis Cloud/Upstash)
HACKNYU_REDIS_URL=redis://localhost:6379

# NFT.Storage API Configuration (for decentralized storage)
# Get from: https://nft.storage/manage
HACKNYU_NFT_STORAGE_API_KEY=your_nft_storage_api_key_here

# Solana Configuration
HACKNYU_SOLANA_RPC_URL=https://api.devnet.solana.com
HACKNYU_SOLANA_NETWORK=devnet

# Wallet Configuration (for server-side NFT minting / custodial co-sign)
# NEVER use your personal wallet here - generate a new one for the server.
#
# Custodial key source — how the server loads its signing keypair:
#   env            (default) read HACKNYU_SERVER_WALLET_PRIVATE_KEY below (dev/devnet)
#   secretsmanager fetch from AWS Secrets Manager at cold start (prod; KMS-encrypted
#                  at rest, decrypted transparently via the Lambda execution role).
HACKNYU_CUSTODIAL_KEY_SOURCE=env

# env source: base58-encoded secret key.
HACKNYU_SERVER_WALLET_PRIVATE_KEY=your_base58_encoded_private_key_here

# secretsmanager source: the secret's ARN or name. Its SecretString is either a raw
# base58 secret key or a JSON envelope like {"privateKey":"<bs58>"}. Requires AWS_REGION.
# HACKNYU_CUSTODIAL_SECRET_ID=arn:aws:secretsmanager:us-east-1:<acct>:secret:hypechain/custodial-key

# Smart Contract Program ID (will be set after deployment)
# Replace this placeholder after running `anchor keys sync` + `anchor deploy`.
HACKNYU_MARKETPLACE_PROGRAM_ID=your_program_id_here

# Evidence Locker — case-file label prefix used by the on-chain Dossier.
# Exactly 8 bytes when UTF-8 encoded (zero-padded if shorter). Example:
# "HC-2026-" → case labels like "HC-2026-000042".
HACKNYU_CASE_PREFIX=HC-2026-

# Merchant Wallet (receives marketplace fees)
HACKNYU_MERCHANT_WALLET_ADDRESS=your_solana_merchant_wallet_address

# DEPRECATED (PR2): the platform custodial wallet is now always derived from
# HACKNYU_SERVER_WALLET_PRIVATE_KEY so guest listings are held by a wallet the
# server can actually sign for (purchase co-sign requires it). This var is no
# longer read by the listing route and can be removed from deployments.
# PLATFORM_CUSTODIAL_WALLET=

# Compressed NFT Configuration (for cost-optimized minting)
# Run 'pnpm setup-tree' to create a Merkle tree and get this address
HACKNYU_MERKLE_TREE_ADDRESS=your_merkle_tree_address_here
# Optional: RPC with DAS API support for querying compressed NFTs
# Recommended providers: Helius (https://helius.dev) or QuickNode (https://quicknode.com)
HACKNYU_DAS_RPC_URL=https://api.devnet.solana.com

# Waitlist — signup confirmation email (AWS SES) + admin export.
# Emails are OFF unless explicitly enabled, so local/dev signups work end-to-end
# without SES. When 'true', SES sends a confirmation to the signup and a
# notification to the admin address; both are best-effort (a send failure never
# fails the signup). SES uses AWS_REGION and requires a VERIFIED sender; in the
# SES sandbox every recipient must also be verified until you request prod access.
HACKNYU_WAITLIST_EMAILS_ENABLED=false
# Verified SES "From" identity (email address or domain).
HACKNYU_SES_SENDER=waitlist@yourdomain.com
# Address that receives a notification on each new signup.
HACKNYU_WAITLIST_ADMIN_EMAIL=ops@yourdomain.com
# Bearer token guarding GET /api/waitlist/export. Generate a long random string;
# without it the export endpoint fails closed (500), never open.
HACKNYU_WAITLIST_EXPORT_TOKEN=generate_a_long_random_token_here
