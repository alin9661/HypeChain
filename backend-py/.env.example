# HypeChain FastAPI backend — environment template.
# Mirrors the HACKNYU_* names from the Express backend so the cutover is a pure
# BACKEND_URL flip. Supabase vars are intentionally REMOVED (migrated to DSQL).

# ---- Server ----
PORT=3001
NODE_ENV=development
HACKNYU_FRONTEND_URL=http://localhost:3000

# ---- OpenRouter (AI vision + image gen) ----
HACKNYU_OPENROUTER_API_KEY=
HACKNYU_DEFAULT_VISION_MODEL=zhipuai/glm-4-plus
HACKNYU_DEFAULT_IMAGE_GEN_MODEL=openai/gpt-5-image-mini

# ---- Redis cache (optional) ----
HACKNYU_REDIS_ENABLED=true
HACKNYU_REDIS_URL=redis://localhost:6379

# ---- Solana / Metaplex ----
HACKNYU_SOLANA_RPC_URL=https://api.devnet.solana.com
HACKNYU_SERVER_WALLET_PRIVATE_KEY=
HACKNYU_MARKETPLACE_PROGRAM_ID=
HACKNYU_CASE_PREFIX=HC-2026-
PLATFORM_CUSTODIAL_WALLET=
# cNFT vars below are DEPRECATED (compressed-NFT path dropped) — kept for compat.
HACKNYU_DAS_RPC_URL=
HACKNYU_MERKLE_TREE_ADDRESS=

# ---- IPFS / NFT.Storage ----
HACKNYU_NFT_STORAGE_API_KEY=

# ---- Aurora DSQL (replaces Supabase) ----
HACKNYU_DSQL_ENDPOINT=
HACKNYU_DSQL_REGION=us-east-1
HACKNYU_DSQL_DATABASE=postgres
# AWS credentials resolved via the standard boto3 chain (env / role / profile).
# LOCAL/CI ONLY — plain Postgres DSN for end-to-end tests against a local container.
# When set, the pool uses normal password auth instead of DSQL IAM+TLS. Leave
# EMPTY in production (DSQL is used). Example local value:
#   postgres://admin:pw@localhost:5432/hypechain
HACKNYU_DATABASE_URL=

# ---- Helius (activity feed: NFT transfer indexing) ----
# Shared secret the Helius webhook sends in its Authorization header. REQUIRED
# for POST /api/webhooks/helius — if unset, every webhook POST is rejected 401
# (fail-closed: an unauthenticated write path would let anyone forge transfer
# events into the provenance feed). Set the SAME value on the Helius webhook.
HACKNYU_HELIUS_WEBHOOK_SECRET=
# API key for Helius DAS / RPC (historical backfill — deferred, optional).
HACKNYU_HELIUS_API_KEY=
