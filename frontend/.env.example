# ============================================
# Frontend Configuration (Next.js)
# ============================================

# Privy Configuration (Wallet Authentication)
# Get your app ID from: https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# Supabase Configuration (User Database - Client-Side)
# Get these from: https://app.supabase.com/project/_/settings/api
# These variables are exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API URL
# For local development: http://localhost:3001
# For production: your Vercel backend URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Solana RPC URL (for frontend wallet interactions)
# Devnet: https://api.devnet.solana.com
# Mainnet: https://api.mainnet-beta.solana.com
# Or use a dedicated RPC provider (Helius, QuickNode, etc.)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# HypeChain Evidence Locker — on-chain program ID.
# Set after running `anchor keys sync` + `anchor deploy --provider.cluster devnet`.
# Must match `HACKNYU_MARKETPLACE_PROGRAM_ID` in backend/.env.
# REQUIRED for a production build: when NODE_ENV=production the client throws at
# import if this is unset or still the Anchor scaffold placeholder (Fg6Pa...sLnS),
# so a half-configured build fails loud. The placeholder fallback is allowed only
# in dev/test.
NEXT_PUBLIC_HYPECHAIN_PROGRAM_ID=your_program_id_here

# Feature flag — when "1", the purchase button builds an Anchor
# `purchase_evidence` instruction instead of a raw SystemProgram.transfer.
# Requires the seller to co-sign (custodial flow today; escrow refactor
# in a future PR). Leave unset for the legacy SOL-only path.
NEXT_PUBLIC_USE_ANCHOR_PURCHASE=

# ============================================
# Server-Side API Routes (Next.js API Routes)
# ============================================
# These variables are ONLY accessible in Next.js API routes
# They are NOT exposed to the browser

# Supabase Configuration (Server-Side with HACKNYU prefix)
# Use the same values as above, but these won't be bundled into client JavaScript
HACKNYU_SUPABASE_URL=https://your-project.supabase.co
HACKNYU_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# Backend Configuration (Express/Node.js)
# ============================================

# OpenRouter API Configuration
# For AI-powered features
OPENROUTER_API_KEY=your_openrouter_api_key_here

# NFT.Storage API Configuration
# For decentralized storage: https://nft.storage
NFT_STORAGE_API_KEY=your_nft_storage_api_key_here

# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# Wallet Configuration (for server-side operations)
SERVER_WALLET_PRIVATE_KEY=your_base58_encoded_private_key_here

# Smart Contract Program ID (will be set after deployment)
MARKETPLACE_PROGRAM_ID=your_program_id_here

# Platform Custodial Wallet (holds NFTs for guest users until they connect a wallet)
# Generate a new wallet specifically for this purpose
PLATFORM_CUSTODIAL_WALLET=your_platform_custodial_wallet_address_here
