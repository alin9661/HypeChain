# HypeChain Frontend Environment Variables

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Solana Network Configuration
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Solana RPC URL (Optional - uses public DevNet endpoint if not set)
# To prevent rate limiting, consider using a custom RPC provider:
#
# Option 1: Use public DevNet (may experience rate limiting)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
#
# Option 2: Helius (Recommended - sign up at https://helius.xyz)
# NEXT_PUBLIC_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY
#
# Option 3: Alchemy (sign up at https://alchemy.com)
# NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-devnet.g.alchemy.com/v2/YOUR_API_KEY
#
# Option 4: QuickNode (sign up at https://quicknode.com)
# NEXT_PUBLIC_SOLANA_RPC_URL=https://YOUR_ENDPOINT.solana-devnet.quiknode.pro/YOUR_API_KEY
#
# Option 5: GenesysGo (free alternative)
# NEXT_PUBLIC_SOLANA_RPC_URL=https://devnet.genesysgo.net/

# Performance Settings (configured in code)
# - Transaction fetch limit: 10 (reduced from 50)
# - Auto-refresh interval: 60 seconds (increased from 30s)
# - Cache TTL: 30 seconds
# - Max retry attempts: 3
# - Exponential backoff: 1s, 2s, 4s
